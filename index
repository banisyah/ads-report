          <td class="r mono" style="color:var(--ink3)">—</td>
          <td class="r mono" style="color:var(--ink3)">0</td>
          <td class="r mono" style="color:var(--ink3)">Rp 0</td>
          <td class="r mono" style="white-space:nowrap">Rp 300.000</td>
          <td class="r"><span class="roas roas-0">0x</span></td>
