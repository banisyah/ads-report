<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Laporan Iklan Shopee — wearmodesti — Apr–Mei 2026</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:        #F5F3EE;
    --surface:   #FDFCFA;
    --surface2:  #F0EDE7;
    --border:    #E2DDD6;
    --border2:   #CEC9C0;
    --ink:       #1C1A17;
    --ink2:      #5C5850;
    --ink3:      #9C968D;
    --accent:    #C4521A;
    --accent-l:  #F5E8DF;
    --green:     #2A6B3C;
    --green-l:   #E3F0E8;
    --blue:      #1A5C9C;
    --blue-l:    #DDE9F5;
    --amber:     #8C5E00;
    --amber-l:   #FDF3DC;
    --red:       #B02020;
    --red-l:     #FAE8E8;
    --r:         8px;
    --r-lg:      14px;
    --shadow:    0 1px 3px rgba(28,26,23,.08), 0 4px 16px rgba(28,26,23,.04);
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  /* ── HEADER ── */
  .header {
    background: var(--ink);
    color: #fff;
    padding: 0 48px;
    position: sticky; top: 0; z-index: 100;
  }
  .header-inner {
    max-width: 1120px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    height: 60px;
  }
  .header-brand { display: flex; align-items: center; gap: 12px; }
  .shopee-dot {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--accent); display: flex; align-items: center;
    justify-content: center; font-size: 14px; flex-shrink: 0;
  }
  .brand-name { font-size: 15px; font-weight: 600; letter-spacing: -.02em; color: #fff; }
  .brand-sub  { font-size: 11px; color: rgba(255,255,255,.45); margin-top: 1px; }
  .period-badge {
    font-family: 'DM Mono', monospace;
    font-size: 11px; color: rgba(255,255,255,.55);
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    padding: 5px 12px; border-radius: 20px;
  }

  /* ── LAYOUT ── */
  .page { max-width: 1120px; margin: 0 auto; padding: 40px 48px 80px; }

  /* ── SECTION ── */
  .section-eyebrow {
    font-size: 10px; font-weight: 600; letter-spacing: .1em;
    text-transform: uppercase; color: var(--ink3);
    margin-bottom: 14px; margin-top: 44px;
    display: flex; align-items: center; gap: 8px;
  }
  .section-eyebrow::after {
    content: ''; flex: 1; height: 1px; background: var(--border);
  }
  .section-eyebrow:first-child { margin-top: 0; }

  /* ── HIGHLIGHT GRID ── */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .kpi-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 20px 22px;
    box-shadow: var(--shadow);
    transition: transform .15s, box-shadow .15s;
  }
  .kpi-card:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(28,26,23,.1); }
  .kpi-card.featured { background: var(--ink); border-color: var(--ink); }
  .kpi-card.featured .kpi-label { color: rgba(255,255,255,.5); }
  .kpi-card.featured .kpi-value { color: #fff; }
  .kpi-card.featured .kpi-sub { color: rgba(255,255,255,.4); }
  .kpi-label {
    font-size: 11px; font-weight: 500; color: var(--ink3);
    margin-bottom: 8px; letter-spacing: .01em;
  }
  .kpi-value {
    font-family: 'DM Mono', monospace;
    font-size: 26px; font-weight: 500; color: var(--ink);
    line-height: 1; letter-spacing: -.02em;
  }
  .kpi-value.accent { color: var(--accent); }
  .kpi-value.green  { color: var(--green); }
  .kpi-sub { font-size: 11px; color: var(--ink3); margin-top: 5px; }

  /* ── TABLE ── */
  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  table { width: 100%; border-collapse: collapse; }
  thead tr { background: var(--surface2); }
  th {
    font-size: 10px; font-weight: 600; letter-spacing: .07em;
    text-transform: uppercase; color: var(--ink3);
    padding: 11px 16px; text-align: left; white-space: nowrap;
    border-bottom: 1px solid var(--border);
  }
  th.r, td.r { text-align: right; }
  td {
    padding: 14px 16px; font-size: 13px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle; color: var(--ink);
  }
  tr:last-child td { border-bottom: none; }
  tbody tr:hover td { background: var(--surface2); }
  tr.total-row td {
    background: var(--surface2); font-weight: 600;
    border-top: 1px solid var(--border2);
    font-size: 13px;
  }
  .prod-name { font-weight: 500; line-height: 1.35; }
  .prod-sub  { font-size: 11px; color: var(--ink3); margin-top: 2px; }
  .mono { font-family: 'DM Mono', monospace; font-size: 12px; }

  /* ── BADGES ── */
  .badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 10px; font-weight: 600; letter-spacing: .03em;
    padding: 3px 8px; border-radius: 20px; white-space: nowrap;
  }
  .badge-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .bg-green  { background: var(--green-l); color: var(--green); }
  .bg-ink    { background: var(--surface2); color: var(--ink2); }

  /* ── ROAS PILL ── */
  .roas {
    font-family: 'DM Mono', monospace;
    font-size: 11px; font-weight: 500;
    padding: 3px 8px; border-radius: 6px; white-space: nowrap;
  }
  .roas-5  { background: var(--green-l); color: var(--green); }
  .roas-3  { background: var(--blue-l);  color: var(--blue); }
  .roas-1  { background: var(--amber-l); color: var(--amber); }
  .roas-0  { background: var(--red-l);   color: var(--red); }

  /* ── ACOS BAR ── */
  .acos-wrap { display: flex; align-items: center; gap: 8px; }
  .acos-bg   { flex: 1; height: 3px; background: var(--border); border-radius: 2px; min-width: 48px; }
  .acos-fill { height: 3px; border-radius: 2px; }
  .acos-good { background: var(--green); }
  .acos-ok   { background: var(--blue); }
  .acos-warn { background: #D4891A; }
  .acos-bad  { background: var(--red); }
  .acos-val  { font-family: 'DM Mono', monospace; font-size: 11px; white-space: nowrap; }
  .acos-val.bad { color: var(--red); font-weight: 500; }

  /* ── INSIGHTS ── */
  .insight-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .insight-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 20px 22px;
    box-shadow: var(--shadow);
    border-left: 3px solid var(--border2);
  }
  .insight-card.green  { border-left-color: var(--green); }
  .insight-card.amber  { border-left-color: #D4891A; }
  .insight-card.red    { border-left-color: var(--red); }
  .insight-card.blue   { border-left-color: var(--blue); }
  .insight-title { font-size: 13px; font-weight: 600; margin-bottom: 6px; line-height: 1.35; }
  .insight-body  { font-size: 12px; color: var(--ink2); line-height: 1.65; }

  /* ── RECOMMENDATION ── */
  .rec-list { display: flex; flex-direction: column; gap: 8px; }
  .rec-item {
    display: flex; gap: 14px; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r); padding: 14px 16px;
    box-shadow: var(--shadow);
  }
  .rec-num {
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--ink); color: #fff;
    font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-top: 1px;
  }
  .rec-text { font-size: 13px; color: var(--ink); line-height: 1.6; }

  /* ── FOOTER ── */
  .footer {
    margin-top: 56px; padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex; justify-content: space-between;
    font-size: 11px; color: var(--ink3);
    font-family: 'DM Mono', monospace;
  }

  /* ── A/B NOTE ── */
  .ab-note {
    background: var(--blue-l); border: 1px solid #B5CDE8;
    border-radius: var(--r); padding: 12px 16px;
    font-size: 12px; color: var(--blue); line-height: 1.6;
    margin-top: 12px;
  }

  @media (max-width: 768px) {
    .page { padding: 24px 20px 60px; }
    .header { padding: 0 20px; }
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .insight-grid { grid-template-columns: 1fr; }
    .table-wrap { overflow-x: auto; }
  }
</style>
</head>
<body>

<header class="header">
  <div class="header-inner">
    <div class="header-brand">
      <div class="shopee-dot">🛍</div>
      <div>
        <div class="brand-name">wearmodesti</div>
        <div class="brand-sub">Laporan Kinerja Iklan · Shopee Indonesia</div>
      </div>
    </div>
    <div class="period-badge">20 Apr – 19 Mei 2026</div>
  </div>
</header>

<div class="page">

  <!-- KPI -->
  <p class="section-eyebrow">Performa Seluruh Iklan</p>
  <div class="kpi-grid">
    <div class="kpi-card featured">
      <div class="kpi-label">Penjualan dari Iklan</div>
