      <div class="kpi-sub">Dari budget Rp 1,65 jt</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Produk Terjual</div>
      <div class="kpi-value">41 unit</div>
      <div class="kpi-sub">Dari 4 iklan produk</div>
    </div>
    <div class="kpi-card">
