    </div>
    <div class="kpi-card">
      <div class="kpi-label">Total Klik</div>
      <div class="kpi-value">1.753</div>
      <div class="kpi-sub">Semua iklan aktif</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Pesanan</div>
      <div class="kpi-value">32</div>
      <div class="kpi-sub">Konversi langsung</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">CTR Rata-rata</div>
      <div class="kpi-value">4,90%</div>
      <div class="kpi-sub">3 iklan produk utama</div>
    </div>
  </div>

  <!-- TABLE -->
  <p class="section-eyebrow">Performa per Iklan</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Nama Iklan</th>
          <th>Periode</th>
          <th>Status</th>
          <th class="r">Dilihat</th>
          <th class="r">Klik</th>
          <th class="r">CTR</th>
          <th class="r">Terjual</th>
          <th class="r">Omzet</th>
          <th class="r">Biaya</th>
          <th class="r">ROAS</th>
          <th>ACOS</th>
        </tr>
      </thead>
      <tbody>
        <!-- Nara Prayer Set -->
        <tr>
          <td>
            <div class="prod-name">Nara Prayer Set</div>
            <div class="prod-sub">Mukena Travel Mini Pouch</div>
          </td>
          <td class="mono" style="color:var(--ink3);font-size:11px">14–19 Mei</td>
          <td><span class="badge bg-green"><span class="badge-dot"></span>Berjalan</span></td>
          <td class="r mono">5.035</td>
          <td class="r mono">297</td>
          <td class="r mono">5,90%</td>
          <td class="r mono">7</td>
          <td class="r mono" style="white-space:nowrap">Rp 954.200</td>
          <td class="r mono" style="white-space:nowrap">Rp 122.566</td>
          <td class="r"><span class="roas roas-5">7,79x</span></td>
          <td>
            <div class="acos-wrap">
              <div class="acos-bg"><div class="acos-fill acos-good" style="width:13%"></div></div>
              <span class="acos-val">12,84%</span>
            </div>
          </td>
        </tr>
        <!-- NAIRA SHORT -->
        <tr>
          <td>
            <div class="prod-name">NAIRA SHORT Bergo</div>
            <div class="prod-sub">Hijab Instant | Tencel</div>
          </td>
          <td class="mono" style="color:var(--ink3);font-size:11px">20 Apr–1 Mei</td>
          <td><span class="badge bg-ink">Berakhir</span></td>
          <td class="r mono">5.142</td>
          <td class="r mono">280</td>
          <td class="r mono">5,45%</td>
          <td class="r mono">12</td>
          <td class="r mono" style="white-space:nowrap">Rp 1.871.350</td>
          <td class="r mono" style="white-space:nowrap">Rp 300.000</td>
          <td class="r"><span class="roas roas-5">6,24x</span></td>
          <td>
            <div class="acos-wrap">
              <div class="acos-bg"><div class="acos-fill acos-ok" style="width:16%"></div></div>
              <span class="acos-val">16,03%</span>
            </div>
          </td>
        </tr>
        <!-- NALA ACTIVE SHORT -->
        <tr>
          <td>
            <div class="prod-name">NALA ACTIVE SHORT Bergo</div>
            <div class="prod-sub">Hijab Instant | Tencel</div>
          </td>
          <td class="mono" style="color:var(--ink3);font-size:11px">20 Apr–19 Mei</td>
          <td><span class="badge bg-green"><span class="badge-dot"></span>Berjalan</span></td>
          <td class="r mono">21.588</td>
          <td class="r mono">996</td>
          <td class="r mono">4,61%</td>
          <td class="r mono">21</td>
          <td class="r mono" style="white-space:nowrap">Rp 3.334.400</td>
          <td class="r mono" style="white-space:nowrap">Rp 639.517</td>
          <td class="r"><span class="roas roas-5">5,21x</span></td>
          <td>
            <div class="acos-wrap">
              <div class="acos-bg"><div class="acos-fill acos-warn" style="width:19%"></div></div>
              <span class="acos-val">19,18%</span>
            </div>
          </td>
        </tr>
        <!-- CALLA -->
        <tr>
          <td>
            <div class="prod-name">CALLA Instant Segitiga</div>
            <div class="prod-sub">Hijab Instant | Tencel</div>
          </td>
          <td class="mono" style="color:var(--ink3);font-size:11px">2–13 Mei</td>
          <td><span class="badge bg-ink">Berakhir</span></td>
          <td class="r mono">4.008</td>
          <td class="r mono">180</td>
          <td class="r mono">4,49%</td>
          <td class="r mono">1</td>
          <td class="r mono" style="white-space:nowrap">Rp 170.050</td>
          <td class="r mono" style="white-space:nowrap">Rp 93.421</td>
          <td class="r"><span class="roas roas-1">1,82x</span></td>
          <td>
            <div class="acos-wrap">
              <div class="acos-bg"><div class="acos-fill acos-bad" style="width:55%"></div></div>
